# Copy to .env and edit. sandbox.sh sources .env when it exists.

# Image to run.
IMAGE_REPO=ghcr.io/ryaneggz/msb-ubuntu-dind
IMAGE_VERSION=latest

# Sandbox identity and resources.
# SANDBOX_NAME also selects the systemd unit instance: msb-sandbox@<name>.service
SANDBOX_NAME=sandbox
CPUS=2
MAX_CPUS=4
MEMORY=2G
MAX_MEMORY=4G
ROOT_DISK=12G

# Persistent Docker data volume. Defaults to <SANDBOX_NAME>-docker-data.
# DOCKER_DATA_VOLUME=sandbox-docker-data
DOCKER_DATA_SIZE=50G

# Working directory inside the sandbox.
WORKDIR=/home/dev

# Host:sandbox directory mounts, space separated. Empty by default.
# Anything you need to survive a sandbox recreate belongs here or in a volume.
# MOUNT_DIRS="/opt/example:/home/dev/example /srv/data:/home/dev/data"
MOUNT_DIRS=""

# Published ports, space separated. Empty by default.
# PORTS="3000:3000 8080:8080"
PORTS=""

# Extra flags appended verbatim to `msb run`, space separated.
# Example: grant this sandbox one shared service on a published host port.
# See docs/shared-services.md.
EXTRA_ARGS=""
