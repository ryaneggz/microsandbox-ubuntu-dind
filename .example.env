# Copy to .env and edit. prod.sh sources .env when it exists.

# Image to run.
IMAGE_REPO=ghcr.io/ryaneggz/msb-ubuntu-dind
IMAGE_VERSION=latest

# Sandbox identity and resources.
SANDBOX_NAME=prod
CPUS=4
MAX_CPUS=8
MEMORY=8G
MAX_MEMORY=16G
ROOT_DISK=12G

# Persistent Docker data volume.
DOCKER_DATA_VOLUME=prod-docker-data
DOCKER_DATA_SIZE=50G

# Working directory inside the sandbox.
WORKDIR=/home/dev

# Host:sandbox directory mounts, space separated.
MOUNT_DIRS="/opt/infra-stack:/home/dev/infra-stack /opt/oh-deploy:/home/dev/oh-deploy /opt/langfuse:/home/dev/langfuse"

# Published ports, space separated.
PORTS="3000:3000 3005:3005"
