[Unit]
Description=microsandbox %i: ensure running + supervise dockerd
Documentation=https://docs.microsandbox.dev/sandboxes/commands
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
Environment=SANDBOX_NAME=%i
ExecStart=%h/microsandbox-ubuntu-dind/ensure-sandbox.sh %i
Restart=always
RestartSec=30
TimeoutStartSec=900
# Only kill the script. The VM is a child of msb start and must survive.
KillMode=process
KillSignal=SIGTERM

[Install]
WantedBy=default.target
